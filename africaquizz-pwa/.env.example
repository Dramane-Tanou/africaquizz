# Africa Quizz - Frontend PWA
# Sous Windows, utilise 127.0.0.1 (et non localhost) pour éviter le problème IPv6.
VITE_API_URL=http://127.0.0.1:8000
VITE_VAPID_PUBLIC_KEY=
# Connexion Google : même ID client OAuth que GOOGLE_CLIENT_ID côté API (bouton masqué si vide)
VITE_GOOGLE_CLIENT_ID=
VITE_APP_ENV=development
